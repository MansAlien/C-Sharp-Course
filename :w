while (true)
{
    Console.Write("Enter a word (or \"quit\" to stop):");
    string? word = Console.ReadLine()?.ToLower();

    if (word == null)
    {
        Console.WriteLine("Input close");
        break;
    }
    if (word == "" || word == " ")
    {
        Console.WriteLine("Invalid input: input empty or spaces are not allowed");
    }
}